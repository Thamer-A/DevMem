+
+describe('formatBytes', () => {
+  it('writes sizes for people', async () => {
+    expect(await ok('formatBytes(0)')).toBe('0 B')
+    expect(await ok('formatBytes(1023)')).toBe('1023 B')
+    expect(await ok('formatBytes(1536)')).toBe('1.5 KB')
+    expect(await ok('(5 * 1024 * 1024).formatBytes()')).toBe('5.0 MB')
+    expect(await fails('formatBytes(n)', { n: -1 })).toBe('INVALID_ARGUMENT')
+  })
+})

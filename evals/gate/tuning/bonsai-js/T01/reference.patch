+describe('startOfWeek', () => {
+  it('finds the Sunday that starts the week', async () => {
+    expect(await ok('startOfWeek(timestamp("2026-11-25T15:00:00Z"))')).toEqual({
+      iso: '2026-11-22T00:00:00.000Z',
+    })
+    expect(await ok('startOfWeek(timestamp("2026-11-22T10:00:00Z"))')).toEqual({
+      iso: '2026-11-22T00:00:00.000Z',
+    })
+    expect(await ok('startOfWeek(timestamp("2026-11-28T23:00:00Z"))')).toEqual({
+      iso: '2026-11-22T00:00:00.000Z',
+    })
+    // Sunday 00:30 in Berlin.
+    expect(await ok('startOfWeek(timestamp("2026-11-28T23:30:00Z"), "Europe/Berlin")')).toEqual({
+      iso: '2026-11-28T23:00:00.000Z',
+    })
+  })
+})

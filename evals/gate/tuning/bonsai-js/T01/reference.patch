+/** Days in a week; isoWeekday() % this is 0 on Sunday. */
+const DAYS_PER_WEEK = 7
+
+/** Midnight at the start of the week, which runs from Sunday to Saturday. */
+function weekStart(d: Date, zone: string | null, site: CallSite): Date {
+  const clock = wallClock(d, zone, site)
+  const midnight = fromWallClock(
+    { ...clock, hour: 0, minute: 0, second: 0, millisecond: 0 },
+    zone,
+    site,
+  )
+  const back = isoWeekday(clock) % DAYS_PER_WEEK
+  return back === 0 ? midnight : addDaysIn(midnight, -back, zone, site)
+}
+
+export const startOfWeek: FunctionDef = /* @__PURE__ */ define(
+  'startOfWeek',
+  [
+    /* @__PURE__ */ overload([ts, optZone], ts, ([d, z], site) => weekStart(d as Date, zoneArg(z), site), {
+      required: 1,
+    }),
+  ],
+  /* @__PURE__ */ zoneAt(1),
+)
+
 export const startOfMonth: FunctionDef = /* @__PURE__ */ startOf('startOfMonth', { day: 1 })
 
 export const startOfYear: FunctionDef = /* @__PURE__ */ startOf('startOfYear', { month: 1, day: 1 })

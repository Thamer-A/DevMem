+describe('sameWeek', () => {
+  it('compares Sunday-to-Saturday weeks', async () => {
+    const d = (iso: string) => new Date(iso)
+    expect(await ok('sameWeek(a, b)', { a: d('2026-11-22T09:00:00Z'), b: d('2026-11-28T18:00:00Z') })).toBe(true)
+    expect(await ok('sameWeek(a, b)', { a: d('2026-11-21T12:00:00Z'), b: d('2026-11-22T12:00:00Z') })).toBe(false)
+    expect(await ok('sameWeek(a, b, "Europe/Berlin")', { a: d('2026-11-28T23:30:00Z'), b: d('2026-11-28T12:00:00Z') })).toBe(false)
+  })
+})

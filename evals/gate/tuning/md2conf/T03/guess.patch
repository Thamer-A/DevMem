+++ b/tests/test_banner.py
@@ -0,0 +1,38 @@
+"""
+Publish Markdown files to Confluence wiki.
+
+Copyright 2022-2026, Levente Hunyadi
+
+:see: https://github.com/hunyadi/md2conf
+"""
+
+import unittest
+from pathlib import Path
+from tempfile import TemporaryDirectory
+
+from md2conf.local import LocalConverter
+from md2conf.metadata import ConfluenceSiteMetadata
+from md2conf.options import Markdown, ProcessorOptions
+from tests.utility import TypedTestCase
+
+
+class TestBanner(TypedTestCase):
+    def _convert(self, options: ProcessorOptions) -> str:
+        with TemporaryDirectory(dir=Path(__file__).parent) as temp_dir:
+            page = Path(temp_dir) / "page.md"
+            page.write_text("# Page", encoding="utf-8")
+            site_metadata = ConfluenceSiteMetadata(domain="example.com", base_path="/wiki/", space_key="SPACE_KEY")
+            LocalConverter(options, site_metadata).process(page)
+            return page.with_suffix(".csf").read_text(encoding="utf-8")
+
+    def test_banner(self) -> None:
+        content = self._convert(ProcessorOptions(banner=Markdown("We are **moving**.")))
+        self.assertIn('<ac:structured-macro ac:name="info" ac:schema-version="1"><ac:rich-text-body><p>We are <strong>moving</strong>.</p>', content)
+        self.assertLess(content.index("generated with a tool"), content.index("moving"))
+
+    def test_no_banner(self) -> None:
+        self.assertEqual(self._convert(ProcessorOptions()).count('ac:name="info"'), 1)
+
+
+if __name__ == "__main__":
+    unittest.main()

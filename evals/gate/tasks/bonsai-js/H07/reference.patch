+describe('roundToNearest', () => {
+  it('rounds to a multiple of the step, halves to even', async () => {
+    expect(await ok('roundToNearest(12, 5)')).toBe(10)
+    expect(await ok('roundToNearest(13, 5)')).toBe(15)
+    expect(await ok('roundToNearest(1.3, 0.25)')).toBe(1.25)
+    expect(await ok('roundToNearest(0.16, 0.05)')).toBe(0.15)
+    expect(await ok('roundToNearest(25, 10)')).toBe(20)
+    expect(await ok('roundToNearest(35, 10)')).toBe(40)
+    expect(await ok('roundToNearest(-25, 10)')).toBe(-20)
+    expect(await fails('roundToNearest(5, s)', { s: 0 })).toBe('INVALID_ARGUMENT')
+    expect(await fails('roundToNearest(5, s)', { s: -1 })).toBe('INVALID_ARGUMENT')
+  })
+})

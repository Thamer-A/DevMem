   ),
 ])
 
+export const roundToNearest: FunctionDef = /* @__PURE__ */ define('roundToNearest', [
+  /* @__PURE__ */ overload([num, num], num, ([n, s], site) => {
+    const value = finite(n as number, site)
+    const step = s as number
+    if (!Number.isFinite(step) || step <= 0)
+      throw site.state.error('INVALID_ARGUMENT', 'Step must be a positive number', site.span)
+    const steps = value / step
+    const below = Math.floor(steps)
+    const fraction = steps - below
+    // A value halfway between two multiples goes to the even one (banker's rounding).
+    let multiple = fraction > 0.5 ? below + 1 : below
+    if (fraction === 0.5) multiple = below % 2 === 0 ? below : below + 1
+    // Clear floating-point noise such as 0.15000000000000002.
+    const result = Number.parseFloat(finite(multiple * step, site).toPrecision(MAX_ROUND_DIGITS))
+    return result === 0 ? 0 : result
+  }),
+])
+
 export const floor: FunctionDef = /* @__PURE__ */ math('floor', Math.floor)
 
 export const ceil: FunctionDef = /* @__PURE__ */ math('ceil', Math.ceil)

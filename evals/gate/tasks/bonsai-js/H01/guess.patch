+export const titleCase: FunctionDef = /* @__PURE__ */ define('titleCase', [
+  /* @__PURE__ */ overload([str], str, ([s], site) => {
+    const text = s as string
+    site.state.charge(1 + (text.length >>> SCAN_SHIFT))
+    return text.replace(/\S+/gu, (word) => {
+      const lower = word.toLowerCase()
+      const head = String.fromCodePoint(lower.codePointAt(0) as number)
+      return head.toUpperCase() + lower.slice(head.length)
+    })
+  }),
+])
+

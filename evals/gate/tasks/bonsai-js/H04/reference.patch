+/** How many characters mask leaves visible at the end. */
+const MASK_VISIBLE = 4
+/** What mask writes in place of each hidden character. */
+const MASK_CHARACTER = '•'
+
+export const mask: FunctionDef = /* @__PURE__ */ define('mask', [
+  /* @__PURE__ */ overload([str], str, ([s], site) => {
+    const text = s as string
+    site.state.charge(1 + (text.length >>> SCAN_SHIFT))
+    // By code point, so a character outside the BMP is hidden as one.
+    const chars = Array.from(text)
+    const visibleFrom = chars.length - MASK_VISIBLE
+    return chars
+      .map((ch, i) => (i >= visibleFrom || ch === ' ' || ch === '-' ? ch : MASK_CHARACTER))
+      .join('')
+  }),
+])
+
 export const trim: FunctionDef = /* @__PURE__ */ define('trim', [
   /* @__PURE__ */ overload([str], str, ([s]) => (s as string).trim()),
 ])

+describe('mask', () => {
+  it('hides all but the last four characters', async () => {
+    expect(await ok('mask("4111 1111 1111 1234")')).toBe('•••• •••• •••• 1234')
+    expect(await ok('"12-34-5678".mask()')).toBe('••-••-5678')
+    expect(await ok('mask("123")')).toBe('123')
+    expect(await ok('mask("")')).toBe('')
+    expect(await fails('mask(x)', { x: 1234 })).toBe('NO_OVERLOAD')
+  })
+})

+describe('chunk', () => {
+  it('splits a list into lists of a size', async () => {
+    expect(await ok('chunk([1, 2, 3, 4, 5], 2)')).toEqual([[1, 2], [3, 4], [5]])
+    expect(await ok('[1, 2, 3].chunk(3)')).toEqual([[1, 2, 3]])
+    expect(await ok('chunk([], 2)')).toEqual([])
+    expect(await fails('chunk([1], n)', { n: 0 })).toBe('INVALID_ARGUMENT')
+    expect(await fails('chunk([1], n)', { n: 1.5 })).toBe('INVALID_ARGUMENT')
+  })
+})

+export const chunk: FunctionDef = /* @__PURE__ */ define('chunk', [
+  /* @__PURE__ */ overload([listT, num], /* @__PURE__ */ t.list(listT), ([l, n], site) => {
+    const items = list(l)
+    const size = integer(n, 'Size', site)
+    if (size <= 0) throw site.state.error('INVALID_ARGUMENT', 'Size must be at least 1', site.span)
+    site.state.charge(items.length)
+    const count = Math.ceil(items.length / size)
+    const out = newList(count, site)
+    for (let i = 0; i < count; i++)
+      out[i] = made(copyOf(items, i * size, Math.min(items.length, (i + 1) * size)), site)
+    return made(out, site)
+  }),
+])
+

+/** Whether `value` lies in the range from `low` (included) to `high` (excluded). */
+function inRange(value: unknown, low: unknown, high: unknown, site: CallSite): boolean {
+  for (const v of [value, low, high]) checkOrderable(v, site)
+  return (
+    (order(value, low, site.state, site.span) as number) >= 0 &&
+    (order(value, high, site.state, site.span) as number) < 0
+  )
+}
+

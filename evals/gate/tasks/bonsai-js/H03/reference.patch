+
+describe('between', () => {
+  it('includes the low end and excludes the high end', async () => {
+    expect(await ok('between(5, 0, 10)')).toBe(true)
+    expect(await ok('between(0, 0, 10)')).toBe(true)
+    expect(await ok('between(10, 0, 10)')).toBe(false)
+    expect(await ok('between(-1, 0, 10)')).toBe(false)
+    const start = new Date('2026-01-01T00:00:00Z')
+    const end = new Date('2026-02-01T00:00:00Z')
+    expect(await ok('between(start, start, end)', { start, end })).toBe(true)
+    expect(await ok('between(end, start, end)', { start, end })).toBe(false)
+    expect(await ok('between(minutes(5), minutes(1), hours(1))')).toBe(true)
+    expect(await fails('between(x, 0, 10)', { x: 'a' })).toBe('NO_OVERLOAD')
+  })
+})

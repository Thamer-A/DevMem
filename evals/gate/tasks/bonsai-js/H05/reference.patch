+/** Joins text items as a sentence would, with Intl.ListFormat. */
+function listText(l: unknown, locale: unknown, defaultLocale: string, site: CallSite): string {
+  const items = list(l)
+  site.state.charge(items.length)
+  const parts: string[] = []
+  let length = 0
+  // oxlint-disable-next-line typescript/prefer-for-of -- indexing never runs a host list's iterator
+  for (let i = 0; i < items.length; i++) {
+    const item = items[i]
+    if (typeof item !== 'string') {
+      throw site.state.error(
+        'TYPE_ERROR',
+        `formatList takes a list of text, not one holding ${describeKind(item)}`,
+        site.span,
+      )
+    }
+    length += item.length + 2
+    parts.push(item)
+  }
+  site.state.stringLimit(length, site.span)
+  const tag = typeof locale === 'string' ? locale : defaultLocale
+  if (tag.length > MAX_LOCALE_LENGTH) {
+    throw site.state.error(
+      'INVALID_ARGUMENT',
+      `Locale tags are at most ${MAX_LOCALE_LENGTH} characters long`,
+      site.span,
+    )
+  }
+  const format = site.state.resource(`l${tag}`, NUMBER_FORMAT_COST, () => {
+    let supported: string[]
+    let created: Intl.ListFormat
+    try {
+      supported = Intl.ListFormat.supportedLocalesOf(tag)
+      created = new Intl.ListFormat(tag, { type: 'conjunction', style: 'long' })
+    } catch (error) {
+      throw site.state.error('INVALID_ARGUMENT', `Invalid locale: ${errorText(error)}`, site.span)
+    }
+    if (supported.length === 0)
+      throw site.state.error('INVALID_ARGUMENT', `Unsupported locale ${shown(tag)}`, site.span)
+    return created
+  })
+  site.state.charge(FORMAT_COST + (length >>> SCAN_SHIFT))
+  return format.format(parts)
+}
+
+export const formatList: FunctionDef = /* @__PURE__ */ define('formatList', [
+  /* @__PURE__ */ overload(
+    [/* @__PURE__ */ t.list(str), /* @__PURE__ */ t.optional(str)],
+    str,
+    ([l, locale], site) => listText(l, locale, 'en-GB', site),
+    { required: 1 },
+  ),
+])
+
 export const min: FunctionDef = /* @__PURE__ */ define('min', /* @__PURE__ */ extremes(-1))
 
 export const max: FunctionDef = /* @__PURE__ */ define('max', /* @__PURE__ */ extremes(1))

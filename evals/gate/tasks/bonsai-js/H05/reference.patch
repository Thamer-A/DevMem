+
+describe('formatList', () => {
+  it('joins text as a sentence would', async () => {
+    expect(await ok('formatList(["Ann", "Bob", "Cy"])')).toBe('Ann, Bob and Cy')
+    expect(await ok('["Ann", "Bob"].formatList()')).toBe('Ann and Bob')
+    expect(await ok('formatList(["Ann"])')).toBe('Ann')
+    expect(await ok('formatList([])')).toBe('')
+    expect(await ok('formatList(["Ann", "Bob", "Cy"], "en-US")')).toBe('Ann, Bob, and Cy')
+    expect(await ok('formatList(["Ann", "Bob", "Cy"], "de-DE")')).toBe('Ann, Bob und Cy')
+    expect(await fails('formatList(xs)', { xs: ['a', 1] })).toBe('TYPE_ERROR')
+    expect(await fails('formatList(["a"], tag)', { tag: 'x'.repeat(65) })).toBe('INVALID_ARGUMENT')
+  })
+})

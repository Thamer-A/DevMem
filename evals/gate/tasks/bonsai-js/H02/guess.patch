+
+describe('quarter', () => {
+  it('counts quarters', async () => {
+    expect(await ok('quarter(timestamp("2026-01-01T00:00:00Z"))')).toBe(1)
+    expect(await ok('quarter(timestamp("2026-08-15T00:00:00Z"))')).toBe(3)
+    expect(await ok('quarter(timestamp("2026-12-31T23:59:59Z"))')).toBe(4)
+    // 31 March 23:30 UTC is already 1 April in London (summer time).
+    expect(await ok('quarter(timestamp("2026-03-31T23:30:00Z"), "Europe/London")')).toBe(2)
+    expect(await ok('quarter(timestamp("2026-03-31T23:30:00Z"))')).toBe(1)
+  })
+})

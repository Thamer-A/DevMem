+
+  it('lists the cost of every host function, declared or default', () => {
+    const env = bonsai({
+      functions: {
+        cheap: fn({ params: [], returns: t.null(), cost: 1, run: () => null }),
+        free: fn({ params: [], returns: t.null(), cost: 0, run: () => null }),
+        plain: noop,
+        remote: fn({ params: [], returns: t.null(), async: true, run: async () => null }),
+      },
+    })
+    const costs = Object.fromEntries(env.listFunctions().map((f) => [f.name, f.cost]))
+    expect(costs.cheap).toBe(1)
+    expect(costs.free).toBe(0)
+    expect(costs.plain).toBe(32)
+    expect(costs.remote).toBe(32)
+    expect(env.describeFunction('plain')?.cost).toBe(32)
+    expect('cost' in (env.describeFunction('trim') ?? {})).toBe(false)
+    // The listed cost is what a call is charged against the step budget.
+    const steps = (maxSteps: number) => codeOf(() => env.evaluateSync('plain()', {}, { maxSteps }))
+    expect(steps(64)).toBe('OK')
+    expect(steps(16)).toBe('STEP_LIMIT')
+  })
 })
 

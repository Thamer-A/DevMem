   /* @__PURE__ */ overload([str], str, ([s]) => (s as string).toLowerCase()),
 ])
 
+export const capitalize: FunctionDef = /* @__PURE__ */ define('capitalize', [
+  /* @__PURE__ */ overload([str], str, ([s]) => {
+    const text = s as string
+    const first = text.codePointAt(0)
+    if (first === undefined) return text
+    // The first code point, so a character outside the BMP is never split.
+    const head = String.fromCodePoint(first)
+    return head.toUpperCase() + text.slice(head.length)
+  }),
+])
+

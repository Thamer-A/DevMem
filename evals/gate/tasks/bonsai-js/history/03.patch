diff --git a/tests/builtins.test.ts b/tests/builtins.test.ts
index 79686fc..7853513 100644
--- a/tests/builtins.test.ts
+++ b/tests/builtins.test.ts
@@ -716,6 +716,18 @@ describe('time functions', () => {
     expect(await fails('hour(at, "Mars/Olympus")', ctx)).toBe('INVALID_ARGUMENT')
   })
 
+  it('counts the days in a month', async () => {
+    expect(await ok('daysInMonth(at)', ctx)).toBe(31)
+    expect(await ok('daysInMonth(timestamp("2024-02-10T00:00:00Z"))')).toBe(29)
+    expect(await ok('daysInMonth(timestamp("2023-02-10T00:00:00Z"))')).toBe(28)
+    expect(await ok('daysInMonth(timestamp("2100-02-10T00:00:00Z"))')).toBe(28)
+    expect(await ok('daysInMonth(timestamp("2026-11-30T12:00:00Z"))')).toBe(30)
+    // 30 November 23:30 UTC is already 1 December in Tokyo.
+    expect(await ok('daysInMonth(timestamp("2026-11-30T23:30:00Z"), "Asia/Tokyo")')).toBe(31)
+    expect(await ok('daysInMonth(at, z)', { at, z: null })).toBe(31)
+    expect(await fails('daysInMonth(at, "Mars/Olympus")', ctx)).toBe('INVALID_ARGUMENT')
+  })
+
   it('finds the start of days, months, and years', async () => {
     expect(await ok('startOfDay(at)', ctx)).toEqual({ iso: '2024-03-10T00:00:00.000Z' })
     expect(await ok('startOfMonth(at)', ctx)).toEqual({ iso: '2024-03-01T00:00:00.000Z' })

+/** The units formatDuration writes, largest first. */
+const DURATION_TEXT_UNITS: readonly (readonly [string, number])[] = [
+  ['d', MS_PER_DAY],
+  ['h', MS_PER_HOUR],
+  ['m', MS_PER_MINUTE],
+  ['s', MS_PER_SECOND],
+]
+/** formatDuration shows this many of the largest non-zero units, and drops the rest. */
+const DURATION_TEXT_PARTS = 2
+
+export const formatDuration: FunctionDef = /* @__PURE__ */ define('formatDuration', [
+  /* @__PURE__ */ overload([dur], str, ([d]) => {
+    const ms = (d as Duration).ms
+    let rest = Math.abs(ms)
+    const parts: string[] = []
+    for (const [unit, size] of DURATION_TEXT_UNITS) {
+      const count = Math.floor(rest / size)
+      rest -= count * size
+      if (count > 0 && parts.length < DURATION_TEXT_PARTS) parts.push(`${count}${unit}`)
+    }
+    if (parts.length === 0) return '0s'
+    return (ms < 0 ? '-' : '') + parts.join(' ')
+  }),
+])
+
 /** Result types that depend on argument types beyond simple type variables. */
 export const RESULT_REFINERS: Readonly<
   Record<string, (args: readonly Type[]) => Type | undefined>

+
+describe('formatDuration', () => {
+  it('writes the two largest units', async () => {
+    expect(await ok('formatDuration(days(2) + hours(3) + minutes(4))')).toBe('2d 3h')
+    expect(await ok('formatDuration(minutes(5) + seconds(12) + milliseconds(900))')).toBe('5m 12s')
+    expect(await ok('(hours(1) + seconds(5)).formatDuration()')).toBe('1h 5s')
+    expect(await ok('formatDuration(seconds(42))')).toBe('42s')
+    expect(await ok('formatDuration(milliseconds(300))')).toBe('0s')
+    expect(await ok('formatDuration(-hours(2))')).toBe('-2h')
+  })
+})

+"""
+Publish Markdown files to Confluence wiki.
+
+Copyright 2022-2026, Levente Hunyadi
+
+:see: https://github.com/hunyadi/md2conf
+"""
+
+import datetime
+import os
+import unittest
+from pathlib import Path
+from tempfile import TemporaryDirectory
+
+from md2conf.converter import format_date
+from md2conf.local import LocalConverter
+from md2conf.metadata import ConfluenceSiteMetadata
+from md2conf.options import Markdown, ProcessorOptions
+from tests.utility import TypedTestCase
+
+
+class TestGeneratedBy(TypedTestCase):
+    def test_format_date(self) -> None:
+        self.assertEqual(format_date(datetime.date(2026, 3, 5)), "5 Mar 2026")
+        self.assertEqual(format_date(datetime.date(2026, 11, 26)), "26 Nov 2026")
+
+    def test_modified_placeholder(self) -> None:
+        with TemporaryDirectory(dir=Path(__file__).parent) as temp_dir:
+            page = Path(temp_dir) / "page.md"
+            page.write_text("# Page\n", encoding="utf-8")
+            stamp = datetime.datetime(2026, 1, 9, 12, 0).timestamp()
+            os.utime(page, (stamp, stamp))
+            site_metadata = ConfluenceSiteMetadata(domain="example.com", base_path="/wiki/", space_key="SPACE_KEY")
+            LocalConverter(ProcessorOptions(generated_by=Markdown("Changed %{modified}")), site_metadata).process(page)
+            content = page.with_suffix(".csf").read_text(encoding="utf-8")
+        self.assertIn("Changed 9 Jan 2026", content)
+
+
+if __name__ == "__main__":
+    unittest.main()

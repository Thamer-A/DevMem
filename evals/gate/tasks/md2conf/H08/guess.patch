+"""
+Publish Markdown files to Confluence wiki.
+
+Copyright 2022-2026, Levente Hunyadi
+
+:see: https://github.com/hunyadi/md2conf
+"""
+
+import shutil
+import unittest
+from pathlib import Path
+from tempfile import TemporaryDirectory
+
+from md2conf.local import LocalConverter
+from md2conf.metadata import ConfluenceSiteMetadata
+from md2conf.options import ProcessorOptions
+from tests.utility import TypedTestCase
+
+
+class TestAltText(TypedTestCase):
+    def _convert(self, text: str) -> None:
+        with TemporaryDirectory(dir=Path(__file__).parent) as temp_dir:
+            page = Path(temp_dir) / "guide" / "page.md"
+            page.parent.mkdir()
+            shutil.copyfile(Path(__file__).parent / "source" / "figure" / "raster.png", page.parent / "pic.png")
+            page.write_text(text, encoding="utf-8")
+            site_metadata = ConfluenceSiteMetadata(domain="example.com", base_path="/wiki/", space_key="SPACE_KEY")
+            LocalConverter(ProcessorOptions(), site_metadata).process(Path(temp_dir))
+
+    def test_missing_alt_text(self) -> None:
+        with self.assertLogs("md2conf", level="WARNING") as logs:
+            self._convert("# Page\n\n![](pic.png)\n")
+        self.assertEqual(logs.records[0].getMessage(), "image without alt text: pic.png (in guide/page.md)")
+
+    def test_alt_text(self) -> None:
+        with self.assertNoLogs("md2conf", level="WARNING"):
+            self._convert("# Page\n\n![A picture](pic.png)\n")
+
+
+if __name__ == "__main__":
+    unittest.main()

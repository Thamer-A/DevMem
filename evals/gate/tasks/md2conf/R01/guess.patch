index 0000000..08c1995
--- /dev/null
+++ b/tests/test_code_languages.py
@@ -0,0 +1,42 @@
+"""
+Publish Markdown files to Confluence wiki.
+
+Copyright 2022-2026, Levente Hunyadi
+
+:see: https://github.com/hunyadi/md2conf
+"""
+
+import re
+import unittest
+from pathlib import Path
+from tempfile import TemporaryDirectory
+
+from md2conf.local import LocalConverter
+from md2conf.metadata import ConfluenceSiteMetadata
+from md2conf.options import ProcessorOptions
+from md2conf.options_converter import ConverterOptions
+from tests.utility import TypedTestCase
+
+
+class TestCodeLanguages(TypedTestCase):
+    def _languages(self, names: list[str], options: ConverterOptions) -> list[str]:
+        with TemporaryDirectory(dir=Path(__file__).parent) as temp_dir:
+            page = Path(temp_dir) / "page.md"
+            page.write_text("".join(f"```{name}\ncode\n```\n\n" for name in names), encoding="utf-8")
+            site_metadata = ConfluenceSiteMetadata(domain="example.com", base_path="/wiki/", space_key="SPACE_KEY")
+            LocalConverter(ProcessorOptions(converter=options), site_metadata).process(page)
+            content = page.with_suffix(".csf").read_text(encoding="utf-8")
+        return re.findall(r'<ac:parameter ac:name="language">([^<]*)</ac:parameter>', content)
+
+    def test_aliases(self) -> None:
+        self.assertListEqual(self._languages(["sh", "zsh", "console", "yml", "ps1", "ts"], ConverterOptions()), ["bash", "bash", "bash", "yaml", "powershell", "typescript"])
+
+    def test_case(self) -> None:
+        self.assertListEqual(self._languages(["Python", "YAML"], ConverterOptions()), ["py", "yaml"])
+
+    def test_unknown_passed_through(self) -> None:
+        self.assertListEqual(self._languages(["MyLang"], ConverterOptions(force_valid_language=False)), ["mylang"])
+
+
+if __name__ == "__main__":
+    unittest.main()

 _GENERATED_BY_REGEXP = re.compile(r"<!--\s+generated[-_]by:\s*(.*)\s+-->")
 
 
+def _split_tags(value: JsonType) -> JsonType:
+    """
+    Accepts tags given as a single comma-separated string (e.g. `tags: markdown, wiki`) as well as a list.
+
+    Surrounding whitespace is removed from each tag, and empty items are dropped.
+    """
+
+    if isinstance(value, str):
+        return [tag.strip() for tag in value.split(",") if tag.strip()]
+    else:
+        return value
+

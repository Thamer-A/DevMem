+    def test_update_byte_order_mark(self) -> None:
+        "Checks if a Markdown file that starts with a byte order mark keeps its front-matter when a page ID is written."
+
+        with MockConfluenceAPI() as api, _create_temporary_directory() as source_dir:
+            document_path = source_dir / "index.md"
+            document_path.write_text("﻿---\ntitle: Saved with BOM\n---\n\nSome text.\n", encoding="utf-8")
+
+            Publisher(api, self.get_processor_options(api, keep_hierarchy=False, skip_update=False)).process_directory(source_dir)
+
+            content = document_path.read_text(encoding="utf-8")
+            self.assertFalse(content.startswith("﻿"))
+            self.assertTrue(content.startswith("---\ntitle: Saved with BOM\n---\n"))
+            page = _get_page_for_document(api, document_path)
+            self.assertEqual(page.title, "Saved with BOM")
+

@@ -0,0 +1,61 @@
+"""
+Publish Markdown files to Confluence wiki.
+
+Copyright 2022-2026, Levente Hunyadi
+
+:see: https://github.com/hunyadi/md2conf
+"""
+
+import unittest
+from pathlib import Path
+from tempfile import TemporaryDirectory
+
+from md2conf.gif import extract_gif_dimensions
+from md2conf.jpeg import ImageFormatError
+from md2conf.local import LocalConverter
+from md2conf.metadata import ConfluenceSiteMetadata
+from md2conf.options import ProcessorOptions
+from tests.utility import TypedTestCase, temporary_file
+
+# 1x1 transparent GIF, with the logical screen size patched by `_gif`
+_GIF_1x1 = bytes.fromhex("47494638396101000100800000000000ffffff21f90401000000002c00000000010001000002024401003b")
+
+
+def _gif(width: int, height: int) -> bytes:
+    return _GIF_1x1[:6] + width.to_bytes(2, "little") + height.to_bytes(2, "little") + _GIF_1x1[10:]
+
+
+class TestGifDimensions(TypedTestCase):
+    "Unit tests for GIF dimension extraction."
+
+    def test_gif_dimensions_from_data(self) -> None:
+        self.assertEqual(extract_gif_dimensions(data=_GIF_1x1), (1, 1))
+        self.assertEqual(extract_gif_dimensions(data=_gif(300, 20)), (300, 20))
+
+    def test_gif_dimensions_from_file(self) -> None:
+        with temporary_file(_gif(640, 480), suffix=".gif") as path:
+            self.assertEqual(extract_gif_dimensions(path=path), (640, 480))
+
+    def test_gif87a(self) -> None:
+        self.assertEqual(extract_gif_dimensions(data=b"GIF87a" + _gif(2, 3)[6:]), (2, 3))
+
+    def test_invalid_gif(self) -> None:
+        with self.assertRaises(ImageFormatError):
+            extract_gif_dimensions(data=b"\x89PNG\r\n\x1a\n")
+        with self.assertRaises(ImageFormatError):
+            extract_gif_dimensions(data=b"GIF89a\x01")
+
+    def test_gif_in_document(self) -> None:
+        with TemporaryDirectory(dir=Path(__file__).parent) as temp_dir:
+            source_dir = Path(temp_dir)
+            (source_dir / "anim.gif").write_bytes(_gif(320, 200))
+            (source_dir / "page.md").write_text("# Animation\n\n![animation](anim.gif)\n", encoding="utf-8")
+            site_metadata = ConfluenceSiteMetadata(domain="example.com", base_path="/wiki/", space_key="SPACE_KEY")
+            LocalConverter(ProcessorOptions(), site_metadata).process(source_dir / "page.md")
+            content = (source_dir / "page.csf").read_text(encoding="utf-8")
+            self.assertIn('ac:original-width="320"', content)
+            self.assertIn('ac:original-height="200"', content)
+
+
+if __name__ == "__main__":
+    unittest.main()

+"""
+Publish Markdown files to Confluence wiki.
+
+Copyright 2022-2026, Levente Hunyadi
+
+:see: https://github.com/hunyadi/md2conf
+"""
+
+from io import BytesIO
+from pathlib import Path
+from typing import BinaryIO, overload
+
+from .jpeg import ImageFormatError
+
+
+def _extract_gif_dimensions(source_file: BinaryIO) -> tuple[int, int]:
+    """
+    Returns the width and height of a GIF image inspecting its header.
+
+    The logical screen width and height follow the 6-byte signature as 16-bit little-endian integers.
+
+    :param source_file: A binary file opened for reading that contains GIF image data.
+    :returns: A tuple of the image's width and height in pixels.
+    """
+
+    signature = source_file.read(6)
+    if signature not in (b"GIF87a", b"GIF89a"):
+        raise ImageFormatError("not a valid GIF file")
+
+    screen = source_file.read(4)
+    if len(screen) != 4:
+        raise ImageFormatError("unexpected end of GIF file")
+
+    width = int.from_bytes(screen[0:2], "little")
+    height = int.from_bytes(screen[2:4], "little")
+    return width, height
+
+
+@overload
+def extract_gif_dimensions(*, data: bytes) -> tuple[int, int]: ...
+
+
+@overload
+def extract_gif_dimensions(*, path: str | Path) -> tuple[int, int]: ...
+
+
+def extract_gif_dimensions(*, data: bytes | None = None, path: str | Path | None = None) -> tuple[int, int]:
+    """
+    Returns the width and height of a GIF image inspecting its header.
+
+    :param data: GIF image data.
+    :param path: Path to the GIF image file.
+    :returns: A tuple of the image's width and height in pixels.
+    """
+
+    if data is not None and path is not None:
+        raise TypeError("expected: either `data` or `path`; got: both")
+    elif data is not None:
+        with BytesIO(data) as f:
+            return _extract_gif_dimensions(f)
+    elif path is not None:
+        with open(path, "rb") as f:
+            return _extract_gif_dimensions(f)
+    else:
+        raise TypeError("expected: either `data` or `path`; got: neither")

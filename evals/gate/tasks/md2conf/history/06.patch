@@ -0,0 +1,52 @@
+"""
+Publish Markdown files to Confluence wiki.
+
+Copyright 2022-2026, Levente Hunyadi
+
+:see: https://github.com/hunyadi/md2conf
+"""
+
+import contextlib
+import io
+import sys
+import unittest
+from pathlib import Path
+from unittest import mock
+
+from md2conf.__main__ import get_parser, main
+from tests.utility import TypedTestCase
+
+
+class TestMain(TypedTestCase):
+    def test_loglevel_any_case(self) -> None:
+        parser = get_parser()
+        for value in ("debug", "DEBUG", "Warning"):
+            with self.subTest(value=value):
+                args = parser.parse_args(["page.md", "--loglevel", value])
+                self.assertEqual(args.loglevel, value.lower())
+
+    def test_loglevel_default(self) -> None:
+        args = get_parser().parse_args(["page.md"])
+        self.assertEqual(args.loglevel, "info")
+
+    def test_loglevel_invalid(self) -> None:
+        with contextlib.redirect_stderr(io.StringIO()), self.assertRaises(SystemExit) as cm:
+            get_parser().parse_args(["page.md", "--loglevel", "verbose"])
+        self.assertEqual(cm.exception.code, 2)
+
+    def test_missing_path(self) -> None:
+        missing = Path(__file__).parent / "no_such_file.md"
+        stderr = io.StringIO()
+        with (
+            mock.patch.object(sys, "argv", ["md2conf", str(missing), "--local"]),
+            contextlib.redirect_stderr(stderr),
+            self.assertRaises(SystemExit) as cm,
+        ):
+            main()
+        self.assertEqual(cm.exception.code, 2)
+        self.assertIn("no such file or directory", stderr.getvalue())
+        self.assertIn("no_such_file.md", stderr.getvalue())
+
+
+if __name__ == "__main__":
+    unittest.main()

diff --git a/tests/test_code_block.py b/tests/test_code_block.py
new file mode 100644
index 0000000..da72883
--- /dev/null
+++ b/tests/test_code_block.py
@@ -0,0 +1,49 @@
+"""
+Publish Markdown files to Confluence wiki.
+
+Copyright 2022-2026, Levente Hunyadi
+
+:see: https://github.com/hunyadi/md2conf
+"""
+
+import unittest
+from pathlib import Path
+from tempfile import TemporaryDirectory
+
+from md2conf.local import LocalConverter
+from md2conf.metadata import ConfluenceSiteMetadata
+from md2conf.options import ProcessorOptions
+from md2conf.options_converter import ConverterOptions
+from tests.utility import TypedTestCase
+
+_DOCUMENT = """# Code
+
+```python
+def main() -> None:
+    print("hello")
+```
+"""
+
+
+class TestCodeBlock(TypedTestCase):
+    def _convert(self, options: ConverterOptions) -> str:
+        with TemporaryDirectory(dir=Path(__file__).parent) as temp_dir:
+            source_dir = Path(temp_dir)
+            (source_dir / "code.md").write_text(_DOCUMENT, encoding="utf-8")
+            site_metadata = ConfluenceSiteMetadata(domain="example.com", base_path="/wiki/", space_key="SPACE_KEY")
+            LocalConverter(ProcessorOptions(converter=options), site_metadata).process(source_dir / "code.md")
+            return (source_dir / "code.csf").read_text(encoding="utf-8")
+
+    def test_default_has_no_line_numbers(self) -> None:
+        content = self._convert(ConverterOptions())
+        self.assertIn('<ac:parameter ac:name="language">py</ac:parameter>', content)
+        self.assertNotIn("linenumbers", content)
+
+    def test_line_numbers(self) -> None:
+        content = self._convert(ConverterOptions(code_line_numbers=True))
+        self.assertIn('<ac:parameter ac:name="language">py</ac:parameter>', content)
+        self.assertIn('<ac:parameter ac:name="linenumbers">true</ac:parameter>', content)
+
+
+if __name__ == "__main__":
+    unittest.main()

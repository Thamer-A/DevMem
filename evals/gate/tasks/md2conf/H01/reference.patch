diff --git a/tests/test_code_block.py b/tests/test_code_block.py
index da72883..a0baac2 100644
--- a/tests/test_code_block.py
+++ b/tests/test_code_block.py
@@ -44,6 +44,34 @@ class TestCodeBlock(TypedTestCase):
         self.assertIn('<ac:parameter ac:name="language">py</ac:parameter>', content)
         self.assertIn('<ac:parameter ac:name="linenumbers">true</ac:parameter>', content)
 
+    def test_short_code_block_is_expanded(self) -> None:
+        content = self._convert(ConverterOptions())
+        self.assertNotIn('<ac:parameter ac:name="collapse">', content)
+
+    def test_long_code_block_is_collapsed(self) -> None:
+        with TemporaryDirectory(dir=Path(__file__).parent) as temp_dir:
+            source_dir = Path(temp_dir)
+            # 20 lines, but well over 2,500 characters
+            lines = "\n".join(f"print({n:04d}, {'x' * 150!r})" for n in range(1, 21))
+            (source_dir / "long.md").write_text(f"# Long\n\n```python\n{lines}\n```\n", encoding="utf-8")
+            site_metadata = ConfluenceSiteMetadata(domain="example.com", base_path="/wiki/", space_key="SPACE_KEY")
+            LocalConverter(ProcessorOptions(), site_metadata).process(source_dir / "long.md")
+            content = (source_dir / "long.csf").read_text(encoding="utf-8")
+        self.assertIn('<ac:parameter ac:name="collapse">true</ac:parameter>', content)
+        self.assertIn("print(0020", content)
+
+    def test_many_short_lines_are_expanded(self) -> None:
+        content = self._convert_text("\n".join(f"x = {n}" for n in range(100)))
+        self.assertNotIn('<ac:parameter ac:name="collapse">', content)
+
+    def _convert_text(self, code: str) -> str:
+        with TemporaryDirectory(dir=Path(__file__).parent) as temp_dir:
+            source_dir = Path(temp_dir)
+            (source_dir / "page.md").write_text(f"# Page\n\n```python\n{code}\n```\n", encoding="utf-8")
+            site_metadata = ConfluenceSiteMetadata(domain="example.com", base_path="/wiki/", space_key="SPACE_KEY")
+            LocalConverter(ProcessorOptions(), site_metadata).process(source_dir / "page.md")
+            return (source_dir / "page.csf").read_text(encoding="utf-8")
+
 
 if __name__ == "__main__":
     unittest.main()

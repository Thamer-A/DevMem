diff --git a/tests/test_toc_level.py b/tests/test_toc_level.py
new file mode 100644
index 0000000..5cd3d3a
--- /dev/null
+++ b/tests/test_toc_level.py
@@ -0,0 +1,50 @@
+"""
+Publish Markdown files to Confluence wiki.
+
+Copyright 2022-2026, Levente Hunyadi
+
+:see: https://github.com/hunyadi/md2conf
+"""
+
+import os
+import unittest
+from pathlib import Path
+from tempfile import TemporaryDirectory
+from unittest import mock
+
+from md2conf.__main__ import get_parser
+from md2conf.clio import get_options
+from md2conf.local import LocalConverter
+from md2conf.metadata import ConfluenceSiteMetadata
+from md2conf.options import ProcessorOptions
+from md2conf.options_converter import ConverterOptions
+from tests.utility import TypedTestCase
+
+
+class TestTocLevel(TypedTestCase):
+    def _options(self, argv: list[str]) -> ProcessorOptions:
+        return get_options(get_parser().parse_args(["page.md", *argv]), ProcessorOptions)
+
+    def test_option(self) -> None:
+        with mock.patch.dict(os.environ, {}, clear=False):
+            os.environ.pop("MD2CONF_TOC_MAX_LEVEL", None)
+            self.assertIsNone(self._options([]).converter.toc_max_level)
+            self.assertEqual(self._options(["--toc-max-level", "3"]).converter.toc_max_level, 3)
+
+    def test_environment(self) -> None:
+        with mock.patch.dict(os.environ, {"MD2CONF_TOC_MAX_LEVEL": "2"}):
+            self.assertEqual(self._options([]).converter.toc_max_level, 2)
+            self.assertEqual(self._options(["--toc-max-level", "4"]).converter.toc_max_level, 4)
+
+    def test_macro(self) -> None:
+        with TemporaryDirectory(dir=Path(__file__).parent) as temp_dir:
+            page = Path(temp_dir) / "page.md"
+            page.write_text("# Page\n\n[[_TOC_]]\n\n## Section\n", encoding="utf-8")
+            site_metadata = ConfluenceSiteMetadata(domain="example.com", base_path="/wiki/", space_key="SPACE_KEY")
+            LocalConverter(ProcessorOptions(converter=ConverterOptions(toc_max_level=2)), site_metadata).process(page)
+            content = page.with_suffix(".csf").read_text(encoding="utf-8")
+        self.assertIn('<ac:parameter ac:name="maxLevel">2</ac:parameter>', content)
+
+
+if __name__ == "__main__":
+    unittest.main()

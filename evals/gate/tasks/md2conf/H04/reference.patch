new file mode 100644
index 0000000..fd05796
--- /dev/null
+++ b/tests/test_clio_env.py
@@ -0,0 +1,55 @@
+"""
+Publish Markdown files to Confluence wiki.
+
+Copyright 2022-2026, Levente Hunyadi
+
+:see: https://github.com/hunyadi/md2conf
+"""
+
+import os
+import unittest
+from argparse import ArgumentParser
+from dataclasses import dataclass, field
+from unittest import mock
+
+from md2conf.clio import add_arguments, boolean_option, get_options, value_option
+from tests.utility import TypedTestCase
+
+
+@dataclass
+class EnvOptions:
+    flag: bool = field(default=False, metadata=boolean_option("Turn on.", "Turn off.", env="MD2CONF_TEST_FLAG"))
+    count: int | None = field(default=None, metadata=value_option("A number.", env="MD2CONF_TEST_COUNT"))
+
+
+def _parse(argv: list[str], env: dict[str, str]) -> EnvOptions:
+    clean = {k: v for k, v in os.environ.items() if not k.startswith("MD2CONF_TEST_")}
+    with mock.patch.dict(os.environ, {**clean, **env}, clear=True):
+        parser = ArgumentParser()
+        add_arguments(parser, EnvOptions)
+        return get_options(parser.parse_args(argv), EnvOptions)
+
+
+class TestEnvironmentOptions(TypedTestCase):
+    def test_defaults(self) -> None:
+        options = _parse([], {})
+        self.assertEqual(options.flag, False)
+        self.assertIsNone(options.count)
+
+    def test_environment(self) -> None:
+        options = _parse([], {"MD2CONF_TEST_FLAG": "true", "MD2CONF_TEST_COUNT": "3"})
+        self.assertEqual(options.flag, True)
+        self.assertEqual(options.count, 3)
+
+    def test_command_line_wins(self) -> None:
+        options = _parse(["--no-flag", "--count", "5"], {"MD2CONF_TEST_FLAG": "1", "MD2CONF_TEST_COUNT": "3"})
+        self.assertEqual(options.flag, False)
+        self.assertEqual(options.count, 5)
+
+    def test_invalid_flag(self) -> None:
+        with self.assertRaises(ValueError):
+            _parse([], {"MD2CONF_TEST_FLAG": "maybe"})
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/tests/test_drafts.py b/tests/test_drafts.py
new file mode 100644
index 0000000..2f599e7
--- /dev/null
+++ b/tests/test_drafts.py
@@ -0,0 +1,41 @@
+"""
+Publish Markdown files to Confluence wiki.
+
+Copyright 2022-2026, Levente Hunyadi
+
+:see: https://github.com/hunyadi/md2conf
+"""
+
+import unittest
+from pathlib import Path
+from tempfile import TemporaryDirectory
+
+from md2conf.local import LocalConverter
+from md2conf.metadata import ConfluenceSiteMetadata
+from md2conf.options import ProcessorOptions
+from tests.utility import TypedTestCase
+
+
+class TestDrafts(TypedTestCase):
+    def _convert(self, options: ProcessorOptions) -> list[str]:
+        with TemporaryDirectory(dir=Path(__file__).parent) as temp_dir:
+            source_dir = Path(temp_dir)
+            (source_dir / "index.md").write_text("# Home", encoding="utf-8")
+            (source_dir / "plans.draft.md").write_text("# Draft", encoding="utf-8")
+            (source_dir / "_index_notes.md").write_text("# Index notes", encoding="utf-8")
+            (source_dir / "sub").mkdir()
+            (source_dir / "sub" / "page.md").write_text("# Page", encoding="utf-8")
+            (source_dir / "sub" / "notes.draft.md").write_text("# Notes", encoding="utf-8")
+            site_metadata = ConfluenceSiteMetadata(domain="example.com", base_path="/wiki/", space_key="SPACE_KEY")
+            LocalConverter(options, site_metadata).process(source_dir)
+            return sorted(p.relative_to(source_dir).as_posix() for p in source_dir.rglob("*.csf"))
+
+    def test_skip_drafts(self) -> None:
+        self.assertListEqual(self._convert(ProcessorOptions(skip_drafts=True)), ["_index_notes.csf", "index.csf", "sub/page.csf"])
+
+    def test_keep_drafts(self) -> None:
+        self.assertListEqual(self._convert(ProcessorOptions()), ["_index_notes.csf", "index.csf", "plans.draft.csf", "sub/notes.draft.csf", "sub/page.csf"])
+
+
+if __name__ == "__main__":
+    unittest.main()

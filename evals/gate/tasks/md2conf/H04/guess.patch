diff --git a/tests/test_drafts.py b/tests/test_drafts.py
new file mode 100644
index 0000000..b63b99c
--- /dev/null
+++ b/tests/test_drafts.py
@@ -0,0 +1,38 @@
+"""
+Publish Markdown files to Confluence wiki.
+
+Copyright 2022-2026, Levente Hunyadi
+
+:see: https://github.com/hunyadi/md2conf
+"""
+
+import unittest
+from pathlib import Path
+from tempfile import TemporaryDirectory
+
+from md2conf.local import LocalConverter
+from md2conf.metadata import ConfluenceSiteMetadata
+from md2conf.options import ProcessorOptions
+from tests.utility import TypedTestCase
+
+
+class TestDrafts(TypedTestCase):
+    def _convert(self, options: ProcessorOptions) -> list[str]:
+        with TemporaryDirectory(dir=Path(__file__).parent) as temp_dir:
+            source_dir = Path(temp_dir)
+            (source_dir / "index.md").write_text("# Home", encoding="utf-8")
+            (source_dir / "draft.md").write_text("---\ndraft: true\n---\n# Draft", encoding="utf-8")
+            (source_dir / "final.md").write_text("---\ndraft: false\n---\n# Final", encoding="utf-8")
+            site_metadata = ConfluenceSiteMetadata(domain="example.com", base_path="/wiki/", space_key="SPACE_KEY")
+            LocalConverter(options, site_metadata).process(source_dir)
+            return sorted(p.relative_to(source_dir).as_posix() for p in source_dir.rglob("*.csf"))
+
+    def test_skip_drafts(self) -> None:
+        self.assertListEqual(self._convert(ProcessorOptions(skip_drafts=True)), ["final.csf", "index.csf"])
+
+    def test_keep_drafts(self) -> None:
+        self.assertListEqual(self._convert(ProcessorOptions()), ["draft.csf", "final.csf", "index.csf"])
+
+
+if __name__ == "__main__":
+    unittest.main()

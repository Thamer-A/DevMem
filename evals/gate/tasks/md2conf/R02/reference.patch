@@ -0,0 +1,38 @@
+"""
+Publish Markdown files to Confluence wiki.
+
+Copyright 2022-2026, Levente Hunyadi
+
+:see: https://github.com/hunyadi/md2conf
+"""
+
+import unittest
+from pathlib import Path
+from tempfile import TemporaryDirectory
+
+from md2conf.local import LocalConverter
+from md2conf.metadata import ConfluenceSiteMetadata
+from md2conf.options import ProcessorOptions
+from tests.utility import TypedTestCase
+
+
+class TestTocMarker(TypedTestCase):
+    def _convert(self, text: str) -> str:
+        with TemporaryDirectory(dir=Path(__file__).parent) as temp_dir:
+            page = Path(temp_dir) / "page.md"
+            page.write_text(text, encoding="utf-8")
+            site_metadata = ConfluenceSiteMetadata(domain="example.com", base_path="/wiki/", space_key="SPACE_KEY")
+            LocalConverter(ProcessorOptions(), site_metadata).process(page)
+            return page.with_suffix(".csf").read_text(encoding="utf-8")
+
+    def test_marker(self) -> None:
+        self.assertIn('ac:name="toc"', self._convert("# Page\n\n[TOC]\n\n## Section\n"))
+
+    def test_marker_in_text(self) -> None:
+        content = self._convert("# Page\n\nWrite [TOC] to get one.\n")
+        self.assertNotIn('ac:name="toc"', content)
+        self.assertIn("Write [TOC] to get one.", content)
+
+
+if __name__ == "__main__":
+    unittest.main()

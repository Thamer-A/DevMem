+def is_markdown_toc(node: ElementType) -> bool:
+    "True if the element is a paragraph that holds nothing but the Python-Markdown table of contents marker `[TOC]`."
+
+    return child_count(node) == 0 and node.text is not None and node.text.strip() == "[TOC]"
+

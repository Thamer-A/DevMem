@@ -0,0 +1,39 @@
+"""
+Publish Markdown files to Confluence wiki.
+
+Copyright 2022-2026, Levente Hunyadi
+
+:see: https://github.com/hunyadi/md2conf
+"""
+
+import unittest
+from pathlib import Path
+from tempfile import TemporaryDirectory
+
+from md2conf.collection import ConfluencePageCollection, ConfluenceUserCollection
+from md2conf.converter import ConfluenceDocument
+from md2conf.metadata import ConfluenceSiteMetadata
+from md2conf.options import ProcessorOptions
+from tests.utility import TypedTestCase
+
+
+class TestFolderLabels(TypedTestCase):
+    def _labels(self, options: ProcessorOptions) -> list[str] | None:
+        with TemporaryDirectory(dir=Path(__file__).parent) as temp_dir:
+            root_dir = Path(temp_dir)
+            page = root_dir / "User Guide" / "Getting Started" / "install.md"
+            page.parent.mkdir(parents=True)
+            page.write_text("---\ntags: [setup]\n---\n<!-- confluence-page-id: 1234 -->\n# Install\n", encoding="utf-8")
+            site_metadata = ConfluenceSiteMetadata(domain="example.com", base_path="/wiki/", space_key="SPACE_KEY")
+            _, document = ConfluenceDocument.create(page, options, root_dir, site_metadata, ConfluencePageCollection(), ConfluenceUserCollection())
+            return document.labels
+
+    def test_folder_labels(self) -> None:
+        self.assertEqual(self._labels(ProcessorOptions(folder_labels=True)), ["setup", "user-guide", "getting-started"])
+
+    def test_no_folder_labels(self) -> None:
+        self.assertEqual(self._labels(ProcessorOptions()), ["setup"])
+
+
+if __name__ == "__main__":
+    unittest.main()

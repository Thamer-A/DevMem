+    def _unique_anchor(self, slug: str) -> str:
+        """
+        Makes an inferred heading identifier unique within the page, the way GitHub does.
+
+        The first heading keeps the plain slug, repeated ones get `-1`, `-2`, etc.
+        """
+
+        count = self.anchor_counts.get(slug)
+        if count is None:
+            self.anchor_counts[slug] = 0
+            return slug
+
+        while True:
+            count += 1
+            candidate = f"{slug}-{count}"
+            if candidate not in self.anchor_counts:
+                break
+        self.anchor_counts[slug] = count
+        self.anchor_counts[candidate] = 0
+        return candidate
+
     def _anchor_warn_or_raise(self, anchor: ElementType, msg: str) -> None:

+"""
+Publish Markdown files to Confluence wiki.
+
+Copyright 2022-2026, Levente Hunyadi
+
+:see: https://github.com/hunyadi/md2conf
+"""
+
+import unittest
+from pathlib import Path
+from tempfile import TemporaryDirectory
+
+from md2conf.converter import MAX_IMAGE_SIZE_BYTES, ConversionError
+from md2conf.local import LocalConverter
+from md2conf.metadata import ConfluenceSiteMetadata
+from md2conf.options import ProcessorOptions
+from md2conf.options_converter import ConverterOptions
+from tests.utility import TypedTestCase
+
+
+class TestImageSize(TypedTestCase):
+    def _convert(self, size: int, options: ProcessorOptions) -> None:
+        png = (Path(__file__).parent / "source" / "figure" / "raster.png").read_bytes()
+        with TemporaryDirectory(dir=Path(__file__).parent) as temp_dir:
+            source_dir = Path(temp_dir)
+            (source_dir / "big.png").write_bytes(png + bytes(size - len(png)))
+            (source_dir / "page.md").write_text("# Page\n\n![big](big.png)\n", encoding="utf-8")
+            site_metadata = ConfluenceSiteMetadata(domain="example.com", base_path="/wiki/", space_key="SPACE_KEY")
+            LocalConverter(options, site_metadata).process(source_dir / "page.md")
+
+    def test_large_image_raises(self) -> None:
+        with self.assertRaises(ConversionError):
+            self._convert(MAX_IMAGE_SIZE_BYTES + 1, ProcessorOptions())
+
+    def test_large_image_warns_when_ignoring_invalid(self) -> None:
+        with self.assertLogs("md2conf", level="WARNING"):
+            self._convert(MAX_IMAGE_SIZE_BYTES + 1, ProcessorOptions(converter=ConverterOptions(force_valid_url=False)))
+
+    def test_image_at_limit(self) -> None:
+        self._convert(MAX_IMAGE_SIZE_BYTES, ProcessorOptions())
+
+
+if __name__ == "__main__":
+    unittest.main()

<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <add key="TokenTtl" value="3600" />
    <add key="PasswordMinLength" value="12" />
    <add key="ApiKeyHeader" value="X-API-Key" />
    <add key="SecretStore" value="KeyVault" />
    <add key="MaxTokens" value="4096" />
  </appSettings>
  <settings>
    <password>
      <description>The database password is read from Key Vault at start-up.</description>
    </password>
    <token>See the admin guide</token>
  </settings>
</configuration>
